# Auto detect text files and perform LF normalization
* text=auto

# These files run on Linux, including when the source is checked out on Windows.
*.sh text eol=lf
*.py text eol=lf
*.snx -text
sonix-packer/** text=auto eol=lf

# Unified diff context includes a leading space before tabs/blank lines.
sonix-player/tools/bluez/*.patch text eol=lf -whitespace
sonix-player/tools/bluealsa/*.patch text eol=lf -whitespace
