#define _GNU_SOURCE
#include <assert.h>
#include <dirent.h>
#include <errno.h>
#include <fcntl.h>
#include <pthread.h>
#include <stdarg.h>
#include <stdbool.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <unistd.h>
#include "src/system/gearboy/gbdb.h"

// API contract seams only: the storage owner algorithm has its own actual
// lifecycle fixture. Real consumer code and all directory-fd I/O execute here.
static uint64_t current_epoch=1;
static char card[1024],old_card[1024];
static bool no_card,read_only,swap_after_pin,swap_at_progress;
static int live_fds,opened[4096],tempfd=-1,mutations,pins,renames,unlinks,writes;
static int fail_open,fail_mkdir,fail_close,fail_rename,fail_file_sync,fail_dir_sync;
static int fail_write,interrupt_write,short_write,zero_write;
static int dir_sync_errno=EIO;

static int track(int fd) {if(fd>=0){assert(fd<4096&&!opened[fd]);opened[fd]=1;live_fds++;}return fd;}
static void plain_mkdir(const char *p) {assert(!mkdir(p,0700)||errno==EEXIST);}
static void make_rom(const char *root) {
 char p[1200];snprintf(p,sizeof(p),"%s/Games",root);plain_mkdir(p);snprintf(p,sizeof(p),"%s/Games/GB",root);plain_mkdir(p);
 snprintf(p,sizeof(p),"%s/Games/GB/game_0.gb",root);FILE*f=fopen(p,"wb");assert(f);char z[1024]={0};for(int k=0;k<32;k++)assert(fwrite(z,1,sizeof(z),f)==sizeof(z));assert(!fclose(f));
}
static void swap_card(void) {assert(!rename(card,old_card));plain_mkdir(card);make_rom(card);current_epoch++;}
bool storage_card_try_admit(storage_card_token_t *out,char *root,size_t size) {
 memset(out,0,sizeof(*out));root[0]=0;if(no_card){errno=ENODEV;return false;}
 assert(strlen(card)<size);strcpy(root,card);out->epoch=current_epoch;return true;
}
int storage_card_try_check(const storage_card_token_t *t) {if(!t||!t->epoch){errno=EINVAL;return -1;}if(no_card||t->epoch!=current_epoch){errno=ESTALE;return -1;}return 0;}
int storage_pin_card_if(const storage_card_token_t *t) {
 pins++;if(storage_card_try_check(t))return -1;if(read_only){errno=EROFS;return -1;}
 int fd=track(open(card,O_RDONLY|O_DIRECTORY|O_CLOEXEC));if(fd>=0&&swap_after_pin){swap_after_pin=false;swap_card();}return fd;
}
static int fixture_mkdirat(int fd,const char *p,mode_t m) {mutations++;if(fail_mkdir){errno=EIO;return -1;}return mkdirat(fd,p,m);}
static int fixture_openat(int fd,const char *p,int flags,...) {
 mode_t mode=0;if(flags&O_CREAT){va_list a;va_start(a,flags);mode=(mode_t)va_arg(a,int);va_end(a);mutations++;}
 if(fail_open){errno=EIO;return -1;}int result=track(openat(fd,p,flags,mode));if(result>=0&&(flags&O_CREAT))tempfd=result;return result;
}
static ssize_t fixture_write(int fd,const void *p,size_t n) {
 writes++;mutations++;if(interrupt_write){interrupt_write=0;errno=EINTR;return -1;}if(fail_write){errno=EIO;return -1;}if(zero_write)return 0;if(short_write&&n>3)n=3;return write(fd,p,n);
}
static int fixture_fsync(int fd) {if((fd==tempfd&&fail_file_sync)||(fd!=tempfd&&fail_dir_sync)){errno=fd==tempfd?EIO:dir_sync_errno;return -1;}return fsync(fd);}
static int fixture_close(int fd) {assert(fd>=0&&fd<4096&&opened[fd]);opened[fd]=0;live_fds--;int result=close(fd);if(fd==tempfd){tempfd=-1;if(fail_close){errno=EIO;return -1;}}return result;}
static __attribute__((unused)) int fixture_reanchor(int fd) {assert(!fixture_close(fd));return track(open(card,O_RDONLY|O_DIRECTORY|O_CLOEXEC));}
static int fixture_renameat(int a,const char *p,int b,const char *q) {mutations++;renames++;assert(a==b&&!strcmp(q,"index.tsv"));if(fail_rename){errno=EIO;return -1;}return renameat(a,p,b,q);}
static int fixture_unlinkat(int fd,const char *p,int f) {mutations++;unlinks++;assert(strstr(p,".index-")==p);return unlinkat(fd,p,f);}
#define mkdirat fixture_mkdirat
#define openat fixture_openat
#define write fixture_write
#define fsync fixture_fsync
#define close fixture_close
#define renameat fixture_renameat
#define unlinkat fixture_unlinkat
#include "@ACTUAL_GBDB_C@"
#undef mkdirat
#undef openat
#undef write
#undef fsync
#undef close
#undef renameat
#undef unlinkat

static void path(char *out,size_t n,const char *root,const char *suffix) {assert(snprintf(out,n,"%s/%s",root,suffix)>0);}
static void write_text(const char *p,const char *text) {FILE*f=fopen(p,"w");assert(f);assert(fputs(text,f)>=0);assert(!fclose(f));}
static bool text_is(const char *p,const char *s) {char b[2048];FILE*f=fopen(p,"r");if(!f)return false;size_t n=fread(b,1,sizeof(b)-1,f);assert(!ferror(f));b[n]=0;assert(!fclose(f));return !strcmp(b,s);}
static void prepare(const char *base,int id,bool cache) {
 assert(!live_fds);snprintf(card,sizeof(card),"%s/card-%d",base,id);snprintf(old_card,sizeof(old_card),"%s/original-%d",base,id);plain_mkdir(card);current_epoch++;no_card=read_only=swap_after_pin=swap_at_progress=false;
 mutations=pins=renames=unlinks=writes=0;fail_open=fail_mkdir=fail_close=fail_rename=fail_file_sync=fail_dir_sync=fail_write=interrupt_write=short_write=zero_write=0;cache_nonce=0;dir_sync_errno=EIO;
 if(cache){char p[1200];path(p,sizeof(p),card,".local");plain_mkdir(p);path(p,sizeof(p),card,".local/gearboy-cache");plain_mkdir(p);path(p,sizeof(p),card,".local/gearboy-cache/index.tsv");write_text(p,"OLD\n");}
}
static void no_temps(void) {char p[1200];path(p,sizeof(p),card,".local/gearboy-cache");DIR*d=opendir(p);assert(d);struct dirent*e;while((e=readdir(d)))assert(strncmp(e->d_name,".index-",7));closedir(d);}
static bool swap_progress(int d,int t,void *u) {(void)d;(void)t;(void)u;assert(!live_fds);if(swap_at_progress){swap_at_progress=false;swap_card();}return true;}
int main(int argc,char **argv) {
 assert(argc==2);cache_entry_t e={.crc=0xABCDEF01,.size=32768,.mtime=123};strcpy(e.path,"/unchanged/game.gb");strcpy(e.name,"Known Name");cache_t c={.items=&e,.count=1,.cap=1};
 const char*expected="ABCDEF01\t32768\t123\t/unchanged/game.gb\tKnown Name\n";char p[1200],other[1200];storage_card_token_t token;
 prepare(argv[1],1,true);token.epoch=current_epoch;assert(!cache_save(&c,&token));path(p,sizeof(p),card,".local/gearboy-cache/index.tsv");assert(text_is(p,expected)&&renames==1&&!live_fds);no_temps();
 prepare(argv[1],2,true);token.epoch=current_epoch;current_epoch++;assert(cache_save(&c,&token)==-ESTALE);assert(!mutations&&!live_fds);path(p,sizeof(p),card,".local/gearboy-cache/index.tsv");assert(text_is(p,"OLD\n"));
 prepare(argv[1],3,false);token.epoch=current_epoch;swap_after_pin=true;assert(!cache_save(&c,&token)&&!live_fds);path(p,sizeof(p),old_card,".local/gearboy-cache/index.tsv");assert(text_is(p,expected));path(p,sizeof(p),card,".local");assert(access(p,F_OK)&&errno==ENOENT);
 // Refuse symlink directory components rather than following them off-card.
 for(int which=0;which<2;which++){prepare(argv[1],4+which,false);snprintf(other,sizeof(other),"%s/escape-%d",argv[1],which);plain_mkdir(other);path(p,sizeof(p),other,"index.tsv");write_text(p,"SENTINEL\n");if(which){path(p,sizeof(p),card,".local");plain_mkdir(p);}path(p,sizeof(p),card,which?".local/gearboy-cache":".local");assert(!symlink(other,p));token.epoch=current_epoch;assert(!cache_save(&c,&token)&&!live_fds&&renames==0);path(p,sizeof(p),other,"index.tsv");assert(text_is(p,"SENTINEL\n"));}
 // Every fallible writer phase leaves the previous complete cache, with no fd/temp leak.
 for(int fault=0;fault<8;fault++){prepare(argv[1],10+fault,true);int*flags[]={&fail_mkdir,&fail_open,&fail_write,&zero_write,&fail_file_sync,&fail_close,&fail_rename,&fail_dir_sync};*flags[fault]=1;token.epoch=current_epoch;assert(!cache_save(&c,&token)&&!live_fds);path(p,sizeof(p),card,".local/gearboy-cache/index.tsv");assert(text_is(p,fault==7?expected:"OLD\n"));no_temps();}
 prepare(argv[1],20,true);interrupt_write=short_write=1;token.epoch=current_epoch;assert(!cache_save(&c,&token)&&writes>2&&!live_fds);path(p,sizeof(p),card,".local/gearboy-cache/index.tsv");assert(text_is(p,expected));no_temps();
 prepare(argv[1],21,true);for(int i=1;i<=8;i++){char suffix[128];snprintf(suffix,sizeof(suffix),".local/gearboy-cache/.index-%ld-%d.tmp",(long)getpid(),i);path(p,sizeof(p),card,suffix);write_text(p,"UNOWNED\n");}token.epoch=current_epoch;assert(!cache_save(&c,&token)&&!live_fds&&!renames&&!unlinks);assert(text_is(p,"UNOWNED\n"));
 // Replacing the final cache symlink must not touch its external target.
 prepare(argv[1],24,true);snprintf(other,sizeof(other),"%s/external-index",argv[1]);write_text(other,"EXTERNAL\n");path(p,sizeof(p),card,".local/gearboy-cache/index.tsv");assert(!unlink(p)&&!symlink(other,p));token.epoch=current_epoch;assert(!cache_save(&c,&token)&&!live_fds);struct stat final;assert(!lstat(p,&final)&&S_ISREG(final.st_mode)&&text_is(p,expected)&&text_is(other,"EXTERNAL\n"));
 // A pin/open failure never enters the mutation phase.
 prepare(argv[1],25,false);token.epoch=current_epoch;assert(!rmdir(card));assert(!cache_save(&c,&token)&&!live_fds&&!mutations);
 // A post-rename EROFS must report published data with uncertain durability.
 prepare(argv[1],26,true);token.epoch=current_epoch;fail_dir_sync=1;dir_sync_errno=EROFS;fprintf(stderr,"PUBLISHED_EROFS_BEGIN\n");assert(!cache_save(&c,&token));fprintf(stderr,"PUBLISHED_EROFS_END\n");path(p,sizeof(p),card,".local/gearboy-cache/index.tsv");assert(text_is(p,expected)&&renames==1&&!live_fds);no_temps();
 prepare(argv[1],27,true);token.epoch=current_epoch;read_only=true;fprintf(stderr,"PREWRITE_EROFS_BEGIN\n");assert(!cache_save(&c,&token));fprintf(stderr,"PREWRITE_EROFS_END\n");path(p,sizeof(p),card,".local/gearboy-cache/index.tsv");assert(text_is(p,"OLD\n")&&!mutations&&!live_fds);
 // Real full scan A, replacement B at the same path during CRC progress.
 prepare(argv[1],22,false);make_rom(card);token.epoch=current_epoch;swap_at_progress=true;gbrom_t*list=NULL;assert(gbdb_scan_admitted(&list,card,&token,swap_progress,NULL)==-ESTALE&&!list&&!live_fds&&!mutations);path(p,sizeof(p),card,".local");assert(access(p,F_OK)&&errno==ENOENT);
 prepare(argv[1],23,false);make_rom(card);read_only=true;gbdb_set_root(card);assert(gbdb_scan(&list,NULL,NULL)==1&&list&&!live_fds&&!mutations);free(list);
 no_card=true;list=(gbrom_t*)1;assert(gbdb_scan(&list,NULL,NULL)==-1&&!list);
 puts("PASS actual GBDB scan/cache: original token, real fd anchor A/B, symlinks, collisions, short/EINTR/zero/error writes, sync/close/rename failure, cleanup, readonly browsing");
}
