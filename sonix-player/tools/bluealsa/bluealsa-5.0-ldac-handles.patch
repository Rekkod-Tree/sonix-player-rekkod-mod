--- /dev/null
+++ b/src/ldac-handle-api.h
@@ -0,0 +1,31 @@
+/* LDAC encoder and stock decoder have incompatible handle implementations. */
+#pragma once
+#include <dlfcn.h>
+#include <stddef.h>
+#include <ldacBT.h>
+
+struct ldac_handle_api {
+	void *library;
+	HANDLE_LDAC_BT (*get)(void);
+	void (*free)(HANDLE_LDAC_BT);
+};
+
+/* Called once during codec setup, before transport workers are started.
+ * Keep the library reference for the daemon lifetime, like linked codecs. */
+static inline int ldac_handle_api_open(struct ldac_handle_api *api, const char *soname) {
+	if (api->library != NULL)
+		return 0;
+	void *library = dlopen(soname, RTLD_NOW | RTLD_LOCAL);
+	if (library == NULL)
+		return -1;
+	HANDLE_LDAC_BT (*get)(void) = dlsym(library, "ldacBT_get_handle");
+	void (*release)(HANDLE_LDAC_BT) = dlsym(library, "ldacBT_free_handle");
+	if (get == NULL || release == NULL) {
+		dlclose(library);
+		return -1;
+	}
+	api->get = get;
+	api->free = release;
+	api->library = library;
+	return 0;
+}
