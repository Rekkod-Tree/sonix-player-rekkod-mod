 /**
  * Transport IO thread cleanup function for pthread cleanup. */
 void ba_transport_pcm_thread_cleanup(struct ba_transport_pcm *pcm) {
+
+	/* An ended encoder must not leave a stale measured bitrate. */
+	ba_transport_pcm_codec_bitrate_set(pcm, 0);
 
 	struct ba_transport *t = pcm->t;
 
@@ -809,6 +813,15 @@
 
 final:
 	return 0;
+}
+
+void ba_transport_pcm_codec_bitrate_set(struct ba_transport_pcm *pcm, unsigned int bitrate) {
+	if ((unsigned int)g_atomic_int_get(&pcm->codec_bitrate) == bitrate)
+		return;
+	g_atomic_int_set(&pcm->codec_bitrate, (int)bitrate);
+	/* No per-packet notification: publish only a changed encoded rate. */
+	if (pcm->ba_dbus_exported)
+		bluealsa_dbus_pcm_update(pcm, BA_DBUS_PCM_UPDATE_CODEC_BITRATE);
 }
 
