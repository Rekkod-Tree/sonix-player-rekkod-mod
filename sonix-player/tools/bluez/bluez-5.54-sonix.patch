+/* Preserve HiBy's A2DP-sink ACL priority command (stock 2.0, opcode 0xfd1a).
+ * This is sent once at profile connection, never polled while audio plays.
+ * The kernel validates the exact connected peer before its handle is used. */
+static void sonix_vendor_priority(struct btd_device *device)
+{
+	struct {
+		struct hci_conn_info_req req;
+		struct hci_conn_info info;
+	} request = { 0 };
+	struct sockaddr_hci addr = {
+		.hci_family = AF_BLUETOOTH,
+		.hci_dev = btd_adapter_get_index(device->adapter),
+		.hci_channel = HCI_CHANNEL_RAW,
+	};
+	uint8_t command[] = { 0x01, 0x1a, 0xfd, 0x04, 0, 0, 0x01, 0x00 };
+	int fd = socket(AF_BLUETOOTH, SOCK_RAW | SOCK_CLOEXEC | SOCK_NONBLOCK,
+							BTPROTO_HCI);
+	if (fd < 0)
+		return;
+	bacpy(&request.req.bdaddr, &device->bdaddr);
+	request.req.type = ACL_LINK;
+	if (bind(fd, (struct sockaddr *) &addr, sizeof(addr)) < 0 ||
+			ioctl(fd, HCIGETCONNINFO, &request) < 0)
+		goto done;
+	command[4] = request.info.handle & 0xff;
+	command[5] = request.info.handle >> 8;
+	if (write(fd, command, sizeof(command)) != sizeof(command))
+		DBG("HiBy ACL priority command unavailable: %s", strerror(errno));
+done:
+	close(fd);
+}
